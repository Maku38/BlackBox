# ==========================================
# BlackBox Virtual SRE Configuration
# ==========================================

# Choose your provider: 'gemini', 'openai', 'claude', or 'local'
# If left blank or commented out, BlackBox will only output the deterministic timeline.
LLM_PROVIDER=gemini

# Your API Key (Required for gemini, openai, claude)
LLM_API_KEY=your_api_key_here

# ------------------------------------------
# Optional Overrides
# ------------------------------------------

# Override the default models:
# LLM_MODEL=gpt-4-turbo                  # Default for OpenAI
# LLM_MODEL=claude-3-haiku-20240307      # Default for Claude
# LLM_MODEL=llama3                       # Default for Local

# Custom URL for Local AI (e.g., Ollama)
# LLM_BASE_URL=http://localhost:11434